# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# demo wedding photos (real people) — kept out of git
/supabase/seed-media/
!.env.example

# real couple data (names, QR codes, photos) — never committed
/private/

# third-party stock photos used only for the garden showcase demo
/supabase/seed-media/

# marketing video: large, kept on disk and in Google Drive, not in git
/docs/marketing/*.mp4
