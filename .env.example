# Local values come from `pnpm exec supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by scripts/ (seed, checks) and, later, admin uploads. Never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local dev admin, created by `pnpm seed:admin` (local Supabase only).
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
