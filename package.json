{
  "name": "the-day",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start -x edge-runtime,vector,logflare,supavisor,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm seed:media",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "seed:media": "tsx --env-file=.env.local scripts/seed-media.ts",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "check:db": "tsx --env-file=.env.local scripts/check-db.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.21.0"
}
